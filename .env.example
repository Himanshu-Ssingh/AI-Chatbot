# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_SERVICE_ACCOUNT_EMAIL: The email of your Google Service Account.
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"

# GOOGLE_PRIVATE_KEY: The private key of your Google Service Account.
# Note: Use a format like "---BEGIN PRIVATE KEY---\n...\n---END PRIVATE KEY---\n"
GOOGLE_PRIVATE_KEY="---BEGIN PRIVATE KEY---\n...\n---END PRIVATE KEY---\n"

# GOOGLE_DRIVE_FOLDER_ID: The ID of the specific folder to search in.
GOOGLE_DRIVE_FOLDER_ID="your-folder-id"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
